{
  "name": "digital-observatory",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "A Markdown-first digital observatory and open research publishing platform.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "generate:artifacts": "node scripts/generate-artifacts.mjs",
    "build": "node scripts/generate-artifacts.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "content:check": "node scripts/check-content.mjs",
    "test": "node scripts/run-tests.mjs",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "check": "npm run content:check && npm run typecheck && npm test && npm run build && npm run verify:artifacts"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
